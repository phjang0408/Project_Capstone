# =========================
# Ignore everything by default
# =========================
*

# =========================
# Allow source code only
# =========================
!Source/
!Source/Capstone/
!Source/Capstone/**
!Source/*.Target.cs

# =========================
# Allow project files
# =========================
!Capstone.uproject
!Config/
!Config/Default*.ini
!.vsconfig

# =========================
# Allow docs
# =========================
!README.md
!Capstone.png
!docs/
!docs/**

# =========================
# Allow git config file
# =========================
!.gitignore
.claude/